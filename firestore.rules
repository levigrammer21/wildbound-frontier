rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CAIRN BEGIN — paste this entire match inside the existing documents match.
    match /gameNamespaces/cairnCrownV1 {
      function joined() {
        return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password'
          && request.auth.token.email is string && request.auth.token.email_verified == true;
      }
      function who() { return request.auth.uid; }
      function my(uid) { return joined() && who() == uid; }
      function id(v) { return v is string && v.size() > 0 && v.size() <= 128; }
      function qty(n, max) { return n is int && n >= 0 && n <= max; }
      function site(v) { return v in ['forge','mill','workshop','kitchen','apothecary','general','furnishings','hatchery']; }
      function cost(v) {
        return v == 'forge' ? 220 : v == 'mill' ? 180 : v == 'workshop' ? 200 :
          v == 'kitchen' ? 170 : v == 'apothecary' ? 210 : v == 'hatchery' ? 235 : 190;
      }
      function clockSlot(v) {
        return qty(v, 999999) && timestamp.value(v * 21600000) <= request.time &&
          timestamp.value((v+2) * 21600000) > request.time;
      }
      function savePath(u) {
        return /databases/$(database)/documents/gameNamespaces/cairnCrownV1/players/$(u);
      }
      function profilePath(u) {
        return /databases/$(database)/documents/gameNamespaces/cairnCrownV1/profiles/$(u);
      }
      function shopPath(s) {
        return /databases/$(database)/documents/gameNamespaces/cairnCrownV1/shops/$(s);
      }
      function petPath(p) {
        return /databases/$(database)/documents/gameNamespaces/cairnCrownV1/pets/$(p);
      }
      function sigPath(sig) {
        return /databases/$(database)/documents/gameNamespaces/cairnCrownV1/signatures/$(sig);
      }
      function marketPath(m) {
        return /databases/$(database)/documents/gameNamespaces/cairnCrownV1/market/$(m);
      }
      function mailPath(u, m) {
        return /databases/$(database)/documents/gameNamespaces/cairnCrownV1/mail/$(u)/entries/$(m);
      }
      function moved() {
        return getAfter(savePath(who())).data.rev == get(savePath(who())).data.rev + 1
          && getAfter(savePath(who())).data.stamp == request.time;
      }
      function named(n, min, max) { return n is string && n.size() >= min && n.size() <= max; }
      function avatar(a) {
        return a.keys().hasOnly(['skin','hair','coat']) &&
          qty(a.skin,4) && qty(a.hair,4) && qty(a.coat,5);
      }
      function petVisual(t) {
        return t.keys().hasOnly(['body','size','color','eye','ears','tail','mark','accessory','eyeShape','accent'])
          && qty(t.body,3) && qty(t.size,3) && qty(t.color,15) && qty(t.eye,7)
          && qty(t.ears,3) && qty(t.tail,3) && qty(t.mark,7) && qty(t.accessory,7)
          && qty(t.eyeShape,2) && qty(t.accent,5);
      }
      function signatureOf(t) {
        return string(t.body)+'-'+string(t.size)+'-'+string(t.color)+'-'+string(t.eye)+'-'+
          string(t.ears)+'-'+string(t.tail)+'-'+string(t.mark)+'-'+string(t.accessory)+'-'+
          string(t.eyeShape)+'-'+string(t.accent);
      }
      function saveShape(d) {
        return d.keys().hasOnly(['name','appearance','xp','bag','bank','gear','vault','eggs','eggSources','gold','karma',
          'equipped','pet','house','quests','kills','activity','ticket','discovery','eventDone','rev','region','report','last','stats','stamp'])
          && named(d.name,2,22) && avatar(d.appearance)
          && qty(d.gold,100000000) && qty(d.karma,100000000)
          && d.bag is map && d.bag.size() <= 64 && d.bank is map && d.bank.size() <= 64
          && d.gear is map && d.gear.size() <= 48 && d.vault is map && d.vault.size() <= 96
          && d.eggs is map && d.eggs.size() <= 4 && d.house is map && d.house.size() <= 25
          && d.xp is map && d.xp.size() == 10 && d.stamp == request.time;
      }
      function property(s) {
        return s.keys().hasOnly(['owner','ownerName','fee','commission','price','level','balance','total','npcSlot',
          'production','sales','npc','history','actor','rev','stamp'])
          && id(s.owner) && named(s.ownerName,2,22) && qty(s.fee,8) && qty(s.commission,15)
          && qty(s.price,100000) && s.level in [1,2,3] && qty(s.balance,100000000)
          && qty(s.total,100000000) && s.npcSlot is int && s.history is list && s.history.size() <= 16
          && s.actor == who() && s.stamp == request.time;
      }
      function closedOffer(before, after, k) {
        return before.state == 'open' && after.actor == who() && after.closed == request.time &&
          after.diff(before).affectedKeys().hasOnly(['state','buyer','actor','nonce','closed'])
          && after.nonce == getAfter(savePath(who())).data.last &&
          ((before.seller == who() && after.state == 'canceled' && after.buyer == '') ||
            (before.seller != who() && after.state == 'sold' && after.buyer == who() &&
              getAfter(savePath(who())).data.gold == get(savePath(who())).data.gold - before.price &&
              getAfter(mailPath(before.seller, after.nonce+'market')).data.offer == k));
      }
      function creditedSale(p) {
        let offer=getAfter(marketPath(p.offer)).data;
        return offer.state == 'sold' && offer.closed == request.time && offer.buyer == who()
          && offer.seller == p.to && offer.shop == p.shop
          && p.gold <= offer.price && p.gold >= offer.price - offer.price*0.15;
      }
      function escrow(before, after) {
        return before.owner == who() && before.state == 'owned'
          && (after.state == 'listed' && after.owner == who() && after.recipient == ''
            && getAfter(marketPath(after.link)).data.asset.id == before.id
          || after.state == 'gifted' && after.owner == who() && id(after.recipient)
            && getAfter(mailPath(after.recipient,after.link)).data.asset.id == before.id
          || after.state == 'released' && after.owner == '' && after.recipient == ''
            && getAfter(savePath(who())).data.karma > get(savePath(who())).data.karma);
      }
      function unlockPet(before, after) {
        return after.state == 'owned' && after.owner == who() && after.recipient == '' &&
          before.link == after.link &&
          ((before.state == 'listed' && getAfter(marketPath(after.link)).data.closed == request.time
            && (getAfter(marketPath(after.link)).data.buyer == who() ||
                  (before.owner == who() && getAfter(marketPath(after.link)).data.state == 'canceled'))) ||
           (before.state == 'gifted' && before.recipient == who()
            && getAfter(mailPath(who(),after.link)).data.state == 'claimed'
            && getAfter(mailPath(who(),after.link)).data.closed == request.time));
      }

      match /clock/{owner} {
        allow get: if my(owner);
        allow create, update: if my(owner) && request.resource.data.keys().hasOnly(['stamp'])
          && request.resource.data.stamp == request.time;
      }
      match /players/{owner} {
        allow get: if my(owner);
        allow create: if my(owner) && saveShape(request.resource.data) && request.resource.data.rev == 1
          && request.resource.data.gold == 85 && request.resource.data.karma == 0;
        allow update: if my(owner) && saveShape(request.resource.data)
          && request.resource.data.rev == resource.data.rev + 1 && request.resource.data.name == resource.data.name
          && named(request.resource.data.last,32,32);
      }
      match /profiles/{owner} {
        allow get: if joined();
        allow list: if joined() && request.query.limit <= 24;
        allow create, update: if my(owner) && request.resource.data.stamp == request.time
          && request.resource.data.keys().hasOnly(['name','appearance','rank','xp','kills','karma','house','weapon','pet','stamp'])
          && request.resource.data.name == getAfter(savePath(owner)).data.name
          && request.resource.data.house == getAfter(savePath(owner)).data.house;
      }
      match /world/{realm} {
        allow get: if joined() && realm == 'calendar';
        function validCalendar() {
          return joined() && realm == 'calendar'
            && request.resource.data.keys().hasOnly(['slot','by','stamp'])
            && clockSlot(request.resource.data.slot) && request.resource.data.stamp == request.time
            && request.resource.data.by == who();
        }
        allow create: if validCalendar();
        allow update: if validCalendar() && request.resource.data.slot > resource.data.slot;
      }
      match /shops/{shop} {
        allow get: if joined() && site(shop);
        allow list: if joined() && request.query.limit <= 8;
        allow create: if joined() && site(shop) && moved() && property(request.resource.data)
          && request.resource.data.owner == who() && request.resource.data.rev == 1 &&
          request.resource.data.balance == 0 && request.resource.data.total == 0 && clockSlot(request.resource.data.npcSlot)
          && getAfter(savePath(who())).data.gold == get(savePath(who())).data.gold - cost(shop);
        allow update: if joined() && site(shop) && moved() && property(request.resource.data)
          && request.resource.data.rev == resource.data.rev + 1
          && (request.resource.data.owner == resource.data.owner &&
            (resource.data.owner == who() ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                ['balance','total','production','sales','npc','npcSlot','history','actor','stamp','rev'])
              && request.resource.data.balance >= resource.data.balance
              && request.resource.data.total >= resource.data.total
              && (request.resource.data.npcSlot == resource.data.npcSlot ||
                (request.resource.data.npcSlot > resource.data.npcSlot && clockSlot(request.resource.data.npcSlot)))) ||
            request.resource.data.owner == who() && resource.data.owner != who() && resource.data.price > 0
              && request.resource.data.price == 0 && request.resource.data.balance == 0
              && getAfter(savePath(who())).data.gold == get(savePath(who())).data.gold - resource.data.price
              && getAfter(mailPath(resource.data.owner,getAfter(savePath(who())).data.last+'deed')).data.gold == resource.data.price);
      }
      match /signatures/{sig} {
        allow get: if joined();
        allow create: if joined() && request.resource.data.keys().hasOnly(['pet','owner','stamp'])
          && request.resource.data.owner == who() && request.resource.data.stamp == request.time
          && getAfter(petPath(request.resource.data.pet)).data.signature == sig;
      }
      match /pets/{pet} {
        allow get: if joined();
        allow list: if joined() && request.query.limit <= 24 && resource.data.owner == who();
        allow create: if joined() && moved() && request.resource.data.id == pet && request.resource.data.original == who()
          && request.resource.data.owner == who() && request.resource.data.actor == who() && request.resource.data.hatched == request.time
          && request.resource.data.stamp == request.time && request.resource.data.state == 'owned' &&
          request.resource.data.history == [] && request.resource.data.hops == 0
          && petVisual(request.resource.data.traits) && request.resource.data.signature == signatureOf(request.resource.data.traits)
          && request.resource.data.buffs.size() >= 1 && request.resource.data.buffs.size() <= 3
          && getAfter(sigPath(request.resource.data.signature)).data.pet == pet;
        allow update: if joined() && moved() && request.resource.data.actor == who()
          && request.resource.data.stamp == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['owner','state','history','hops','link','recipient','name','actor','stamp'])
          && request.resource.data.history.size() <= 32 && named(request.resource.data.name,1,20)
          && ((resource.data.owner == who() && resource.data.state == 'owned'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','actor','stamp','link'])) ||
            escrow(resource.data,request.resource.data) || unlockPet(resource.data,request.resource.data));
        match /trail/{hop} {
          allow get: if joined();
          allow list: if joined() && request.query.limit <= 24;
          allow create: if joined() && moved()
            && request.resource.data.keys().hasOnly(['from','to','at','kind','stamp'])
            && request.resource.data.stamp == request.time
            && request.resource.data.from == get(petPath(pet)).data.owner
            && request.resource.data.to == getAfter(petPath(pet)).data.owner
            && getAfter(petPath(pet)).data.hops == get(petPath(pet)).data.hops + 1
            && hop == string(getAfter(petPath(pet)).data.hops)
            && request.resource.data.kind in ['release','sale','gift'];
        }
      }
      match /market/{offer} {
        allow get: if joined();
        allow list: if joined() && request.query.limit <= 24 && resource.data.state == 'open';
        allow create: if joined() && moved() && request.resource.data.keys().hasOnly(
          ['seller','sellerName','asset','price','shop','state','buyer','stamp','actor','nonce'])
          && request.resource.data.seller == who() && request.resource.data.actor == who()
          && request.resource.data.nonce == getAfter(savePath(who())).data.last && request.resource.data.nonce == offer
          && request.resource.data.price > 0 && qty(request.resource.data.price,100000) && site(request.resource.data.shop)
          && request.resource.data.state == 'open' && request.resource.data.buyer == '' && request.resource.data.stamp == request.time
          && request.resource.data.asset.kind in ['pet','gear','item','egg'];
        allow update: if joined() && moved() && closedOffer(resource.data,request.resource.data,offer);
      }
      match /mail/{receiver}/entries/{letter} {
        allow get: if my(receiver);
        allow list: if my(receiver) && request.query.limit <= 24;
        allow create: if joined() && moved() && request.resource.data.from == who() && receiver != who()
          && request.resource.data.to == receiver && request.resource.data.state == 'open' && request.resource.data.stamp == request.time
          && (request.resource.data.kind == 'gift' && request.resource.data.asset.kind in ['pet','gear','item','egg']
              && exists(profilePath(receiver)) && letter == getAfter(savePath(who())).data.last+'gift'
           || request.resource.data.kind == 'sale' && qty(request.resource.data.gold,100000)
              && letter == getAfter(savePath(who())).data.last+'market' && creditedSale(request.resource.data)
           || request.resource.data.kind in ['revenue','deed'] && site(request.resource.data.shop) && qty(request.resource.data.gold,100000000)
              && ((letter == getAfter(savePath(who())).data.last+'deed' || letter == getAfter(savePath(who())).data.last+'credit')
                  && get(shopPath(request.resource.data.shop)).data.owner == receiver
                  && getAfter(shopPath(request.resource.data.shop)).data.owner == who()
                  || letter == getAfter(savePath(who())).data.last+'fee'
                    && get(savePath(who())).data.activity.quote.owner == receiver
                    && get(savePath(who())).data.activity.quote.shop == request.resource.data.shop
                    && request.resource.data.gold == get(savePath(who())).data.gold - getAfter(savePath(who())).data.gold));
        allow update: if my(receiver) && moved() && resource.data.state == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','closed'])
          && request.resource.data.state == 'claimed' && request.resource.data.closed == request.time;
      }
    }
    // CAIRN END
  }
}
